# Nexus build-time constants — copy to .env.local and fill in.
# Everything here is PUBLIC by design (it ships inside the shared HTML file),
# so restrict each credential in Google Cloud Console:
#   - OAuth client: authorized JS origins = your Pages URL + http://localhost:5173
#   - API key: API restriction = Google Drive API; Application restriction = HTTP referrers (your Pages URL)

VITE_NEXUS_CLIENT_ID=<oauth-client-id>.apps.googleusercontent.com
VITE_NEXUS_API_KEY=<api-key>
# Optional: workspace IDs (users can also arrive via links; the app remembers the last good ones)
VITE_NEXUS_ROOT_FOLDER_ID=
VITE_NEXUS_FILE_ID=
# Optional: write relay (Deno Deploy) — editors write without any Google session.
# Leave empty to use Google sign-in directly. See relay/README.md.
VITE_NEXUS_RELAY_URL=
